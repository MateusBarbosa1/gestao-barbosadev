# Copie para .env (no seu computador) ou cadastre no Render em Environment.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# --- Painel ---
PORT=3000
# Assina os logins. No Render é gerado sozinho. Localmente, qualquer texto longo e aleatório.
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Dados no GitHub (opcional; sem isto usa data/db.json)
# GITHUB_REPO=MateusBarbosa1/barbosadev-dados
# GITHUB_TOKEN=github_pat_...

# --- WhatsApp Cloud API (Meta) ---
# Token PERMANENTE de Usuário do Sistema (Configurações do negócio → Usuários do sistema),
# com as permissões whatsapp_business_messaging e whatsapp_business_management.
WA_TOKEN=
# Meta for Developers → seu app → Configurações do app → Básico → Chave secreta do app.
WA_APP_SECRET=
# Texto que VOCÊ inventa e cola também no painel da Meta, na configuração do webhook.
WA_VERIFY_TOKEN=
# Versão da Graph API (confira a mais recente em developers.facebook.com/docs/graph-api/changelog)
WA_GRAPH_VERSION=v23.0
